    <!-- Modes -->
    <string name="mode_simple">Tap reaction</string>
    <string name="mode_simple_desc">Tap the instant the screen turns green.</string>
    <string name="mode_simple_how">Wait for the screen to turn green, then tap anywhere as fast as you can. Tapping early is a false start.</string>

    <string name="mode_sound">Sound reaction</string>
    <string name="mode_sound_desc">Tap the instant you hear the beep.</string>
    <string name="mode_sound_how">Nothing on screen changes, so look away if you like. Tap anywhere the moment you hear the beep.</string>

    <string name="mode_gonogo">Go / No-Go</string>
    <string name="mode_gonogo_desc">Tap on green circles. Hold back on red squares.</string>
    <string name="mode_gonogo_how">A green circle means tap. A red square means don\'t. Keep your eyes on the cross in the middle.</string>

    <string name="mode_choice">Choice reaction</string>
    <string name="mode_choice_desc">Hit whichever of four pads lights up.</string>
    <string name="mode_choice_how">Keep your fingers near the four pads. When one lights up, tap that one as fast as you can.</string>

    <string name="mode_aim">Aim</string>
    <string name="mode_aim_desc">Tap targets as they pop up around the screen.</string>
    <string name="mode_aim_how">Targets appear one at a time. Tap each one as fast as you can. Taps that miss count against your accuracy.</string>

