<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_length"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/length_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/length_short"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_short"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/length_standard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_standard"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/length_long"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_long"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </RadioGroup>

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/length_hint"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/haptics"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_haptics"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_cue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cue_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_mode_sound"
            android:drawablePadding="10dp"
            android:drawableTint="@color/text2"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cue_choose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cue_choose"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <Button
                android:id="@+id/cue_play"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cue_play"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <Button
                android:id="@+id/cue_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cue_reset"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cue_hint"
            android:textSize="13sp" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_timing_title"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_timing_body"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
