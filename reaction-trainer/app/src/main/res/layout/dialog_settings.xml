<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_length"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/length_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/length_short"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_short"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/length_standard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_standard"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/length_long"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/length_long"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </RadioGroup>

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/length_hint"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/haptics"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_haptics"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_timing_title"
            android:textSize="15sp" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_timing_body"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
