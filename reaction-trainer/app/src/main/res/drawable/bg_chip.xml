<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_light">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface2" />
                    <stroke android:width="1dp" android:color="@color/text3" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
